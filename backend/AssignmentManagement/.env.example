# Backend Environment Configuration
# Copy this file to appsettings.Development.json or set environment variables

# PostgreSQL Connection
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=assignment_mgmt;Username=asm_user;Password=asm_pass

# JWT Settings - IMPORTANT: Replace with a secure secret key in production!
JwtSettings__SecretKey=YOUR_SECURE_SECRET_KEY_AT_LEAST_32_CHARACTERS_LONG
JwtSettings__ExpiryMinutes=1440
JwtSettings__Issuer=AssignmentManagementAPI
JwtSettings__Audience=AssignmentManagementClient
