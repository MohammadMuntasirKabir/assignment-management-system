# Copy this file to .env and fill in real values.
# docker-compose reads .env automatically for the ${VAR:-default} substitutions.

# Required in Production. Must be at least 32 characters of secure random data.
# Generate one with: openssl rand -base64 48
JWT_SECRET=

# Database password. Overrides the local-dev default used by appsettings.json.
POSTGRES_PASSWORD=
